{
  "name": "@hilaac/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./demo": "./scripts/demo/donnees.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- tsx scripts/migrate.ts",
    "db:seed": "dotenv -e ../../.env -- tsx scripts/seed.ts",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@hilaac/core": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
