# Copier vers .env (pnpm local:setup le fait automatiquement s'il est absent).
# Valeurs locales correspondant à docker-compose.dev.yml — aucune n'est un secret de production.

# PostgreSQL — un rôle par usage (voir CLAUDE.md, « Rôles Postgres »).
# Propriétaire du schéma : migrations et seed uniquement.
DATABASE_URL=postgres://hilaac:hilaac@localhost:5432/hilaac
# Requêtes métier de apps/web, soumises à Row Level Security.
DATABASE_URL_APP=postgres://hilaac_app:hilaac_app_local@localhost:5432/hilaac
# Better Auth (apps/web) : tables d'authentification uniquement.
DATABASE_URL_AUTH=postgres://hilaac_auth:hilaac_auth_local@localhost:5432/hilaac
# apps/worker : BYPASSRLS, seul processus qui écrit les données collectées.
DATABASE_URL_WORKER=postgres://hilaac_worker:hilaac_worker_local@localhost:5432/hilaac

# Better Auth — secret de signature des sessions (32 caractères minimum, propre à chaque environnement)
BETTER_AUTH_SECRET=local-uniquement-a-remplacer-hors-developpement
BETTER_AUTH_URL=http://localhost:3000

# Redis — utilisé par apps/web (health) et apps/worker (BullMQ)
REDIS_URL=redis://localhost:6379

# Niveau de journalisation du worker : fatal | error | warn | info | debug | trace
LOG_LEVEL=info
